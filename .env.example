# Settings for the P1 demo layer (ADR-023). Export them in your shell, or copy
# this file to `.env` (never committed) for Docker Compose to pick up.

# Where uploaded documents, their chunks and their embeddings are stored.
LEGALRAG_DATA_DIR=data/app

# Generator: `ollama:<model>` (local Ollama server) or `hf:<repo>` (transformers
# on CPU). The measured choice and the rule that picked it are in EVAL.md, Run 4.
LEGALRAG_MODEL=ollama:gemma3:4b

# Local Ollama server. From inside a Docker container use
# http://host.docker.internal:11434 instead.
OLLAMA_HOST=http://127.0.0.1:11434

# Hugging Face model cache. The e5-base embedding model alone is ~1.1 GB, so
# point this at a disk with room before the first run.
HF_HUB_CACHE=

# `hf:` weights tried here first (task 1.2), falling back to HF_HUB_CACHE above.
LEGALRAG_MODELS_DIR=models
